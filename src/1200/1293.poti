var entrada := leia_texto
enquanto não eof faça
    a = entrada.divida(" ").mapeie(_.real)
    x1, y1, x2, y2, cmd, enf = a[1], a[2], a[3], a[4], a[5], a[6]
    distancia = raiz((x2-x1)^2 + (y2-y1)^2)
    alfa = cmd * PI / 180
    beta = enf * PI / 180
    resultado = distancia * (1 / tg(alfa) + 1 / tg(beta))
    escreva resultado formato "%.3f"
    entrada := leia_texto
fim